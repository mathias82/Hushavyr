{
  "name": "ai-privacy-router",
  "displayName": "AI Privacy Router",
  "description": "Privacy-aware local AI routing",
  "version": "0.0.3",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:aiPrivacyRouter.classifySelection",
    "onCommand:aiPrivacyRouter.askLocal",
    "onCommand:aiPrivacyRouter.askLocalSelection",
    "onCommand:aiPrivacyRouter.reviewCloudOverride",
    "onCommand:aiPrivacyRouter.privacyPreview",
    "onChatParticipant:ai-privacy-router.privacy",
    "onCommand:aiPrivacyRouter.runTests"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiPrivacyRouter.classifySelection",
        "title": "AI Privacy Router: Classify Selection"
      },
      {
        "command": "aiPrivacyRouter.askLocal",
        "title": "AI Privacy Router: Ask Local Qwen"
      },
      {
        "command": "aiPrivacyRouter.askLocalSelection",
        "title": "AI Privacy Router: Ask Local Qwen About Selection"
      },
      {
        "command": "aiPrivacyRouter.reviewCloudOverride",
        "title": "AI Privacy Router: Review Cloud Override (No Transfer)"
      },
      {
        "command": "aiPrivacyRouter.privacyPreview",
        "title": "AI Privacy Router: Privacy Preview of Selection"
      },
      {
        "command": "aiPrivacyRouter.runTests",
        "title": "AI Privacy Router: Run Existing Regression Tests"
      }
    ],
    "configuration": {
      "title": "AI Privacy Router",
      "properties": {
        "aiPrivacyRouter.ollamaModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Locally installed Ollama model name",
          "scope": "application"
        },
        "aiPrivacyRouter.ollamaEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Loopback HTTP Ollama origin only; remote hosts and redirects are rejected.",
          "scope": "application"
        },
        "aiPrivacyRouter.timeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 1,
          "maximum": 600,
          "description": "Timeout for each local model request.",
          "scope": "application"
        },
        "aiPrivacyRouter.verifierModel": {
          "type": "string",
          "default": "",
          "description": "Optional second locally installed model for the verification pass. Empty uses the review model.",
          "scope": "application"
        },
        "aiPrivacyRouter.mandatoryLocalOnly": {
          "type": "boolean",
          "default": false,
          "description": "Deny even review-only cloud override approvals. Cloud dispatch remains disabled regardless.",
          "scope": "application"
        },
        "aiPrivacyRouter.requireReviewer": {
          "type": "boolean",
          "default": false,
          "description": "Require verified reviewer approval. No reviewer identity provider is connected, so enabling this denies override approvals.",
          "scope": "application"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "ai-privacy-router.privacy",
        "name": "ai-privacy",
        "fullName": "AI Privacy Router",
        "description": "Private local Qwen assistant via Ollama",
        "isSticky": true,
        "commands": [
          {
            "name": "review",
            "description": "Review selected or attached code with local Qwen"
          },
          {
            "name": "test",
            "description": "Choose and run the existing local project test suite"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "package:vsix": "npm run build && vsce package --no-dependencies",
    "ai:start": "bash scripts/start-local-ai.sh",
    "ai:serve": "bash scripts/start-local-ai.sh --serve-only",
    "review:benchmark": "npm run build && node dist/benchmark.js",
    "update:local": "node scripts/update-local.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0",
    "@vscode/vsce": "^3.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mathias82/ai-privacy-router.git"
  }
}
