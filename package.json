{
  "name": "ai-privacy-router",
  "displayName": "AI Privacy Router",
  "description": "Privacy-aware local AI routing",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:aiPrivacyRouter.classifySelection"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiPrivacyRouter.classifySelection",
        "title": "AI Privacy Router: Classify Selection"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
