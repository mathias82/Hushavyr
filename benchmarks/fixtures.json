{
  "schemaVersion": 1,
  "description": "112 synthetic polyglot cases across 10 languages; Kotlin and Rust include negative controls; no positive Rust detector coverage is claimed. Results must be measured, not inferred.",
  "cases": [
    {
      "id": "js-eval",
      "language": "javascript",
      "path": "javascript/eval.js",
      "code": "function execute(input) {\n  return eval(input);\n}\n",
      "expected": [
        "unsafe-dynamic-code-evaluation"
      ],
      "category": "security"
    },
    {
      "id": "ts-eval",
      "language": "typescript",
      "path": "typescript/eval.ts",
      "code": "export function execute(input: string): unknown {\n  return eval(input);\n}\n",
      "expected": [
        "unsafe-dynamic-code-evaluation"
      ],
      "category": "security"
    },
    {
      "id": "py-eval",
      "language": "python",
      "path": "python/eval.py",
      "code": "import pickle\ndef execute(user_input):\n    return pickle.loads(user_input)\n",
      "expected": [
        "unsafe-python-deserialization"
      ],
      "category": "security"
    },
    {
      "id": "java-exec",
      "language": "java",
      "path": "java/Exec.java",
      "code": "class Exec {\n  void run(String input) throws Exception {\n    Runtime.getRuntime().exec(input);\n  }\n}\n",
      "expected": [
        "potential-command-execution"
      ],
      "category": "security"
    },
    {
      "id": "go-exec",
      "language": "go",
      "path": "go/exec.go",
      "code": "package main\nimport \"os/exec\"\nfunc run(input string) error {\n  return exec.Command(\"sh\", \"-c\", input).Run()\n}\n",
      "expected": [
        "potential-command-execution"
      ],
      "category": "security"
    },
    {
      "id": "php-eval",
      "language": "php",
      "path": "php/eval.php",
      "code": "<?php\nfunction run($input) {\n  eval($input);\n}\n",
