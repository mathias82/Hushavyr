{
  "schemaVersion": 1,
  "description": "Synthetic polyglot cases calibrated to built-in Hushavyr security rule IDs. Run the actual CLI with benchmarks/run.mjs; optional Semgrep findings may change precision.",
  "cases": [
    {
      "id": "js-eval",
      "language": "javascript",
      "path": "javascript/eval.js",
      "code": "function execute(input) {\n  return eval(input);\n}\n",
      "expected": [
        "unsafe-dynamic-code-evaluation"
      ],
      "category": "security"
    },
    {
      "id": "ts-eval",
      "language": "typescript",
      "path": "typescript/eval.ts",
      "code": "export function execute(input: string): unknown {\n  return eval(input);\n}\n",
      "expected": [
        "unsafe-dynamic-code-evaluation"
      ],
      "category": "security"
    },
    {
      "id": "py-eval",
      "language": "python",
      "path": "python/eval.py",
      "code": "import pickle\ndef execute(user_input):\n    return pickle.loads(user_input)\n",
      "expected": [
        "unsafe-python-deserialization"
      ],
      "category": "security"
    },
    {
      "id": "java-exec",
      "language": "java",
      "path": "java/Exec.java",
      "code": "class Exec {\n  void run(String input) throws Exception {\n    Runtime.getRuntime().exec(input);\n  }\n}\n",
      "expected": [
        "potential-command-execution"
      ],
      "category": "security"
    },
    {
      "id": "go-exec",
      "language": "go",
      "path": "go/exec.go",
      "code": "package main\nimport \"os/exec\"\nfunc run(input string) error {\n  return exec.Command(\"sh\", \"-c\", input).Run()\n}\n",
      "expected": [
        "potential-command-execution"
      ],
      "category": "security"
    },
    {
      "id": "php-eval",
      "language": "php",
      "path": "php/eval.php",
      "code": "<?php\nfunction run($input) {\n  eval($input);\n}\n",
      "expected": [
        "unsafe-dynamic-code-evaluation"
      ],
      "category": "security"
    },
    {
      "id": "ruby-eval",
      "language": "ruby",
      "path": "ruby/eval.rb",
      "code": "require 'openssl'\ndef run\n  OpenSSL::SSL::VERIFY_NONE\n  verify_mode = OpenSSL::SSL::VERIFY_NONE\nend\n",
      "expected": [
        "tls-certificate-validation-disabled"
      ],
      "category": "security"
    },
    {
      "id": "cs-exec",
      "language": "csharp",
      "path": "csharp/Exec.cs",
      "code": "using System.Diagnostics;\nclass Exec {\n  void Run(string input) {\n    Process.Start(input);\n  }\n}\n",
      "expected": [
        "potential-command-execution"
      ],
      "category": "security"
    },
    {
      "id": "js-clean",
      "language": "javascript",
      "path": "javascript/clean.js",
      "code": "export function add(a, b) {\n  return a + b;\n}\n",
      "expected": [],
      "category": "clean"
    },
    {
      "id": "py-clean",
      "language": "python",
      "path": "python/clean.py",
      "code": "def add(a, b):\n    return a + b\n",
      "expected": [],
      "category": "clean"
    },
    {
      "id": "java-clean",
      "language": "java",
      "path": "java/Clean.java",
      "code": "class Clean {\n  int add(int a, int b) { return a + b; }\n}\n",
      "expected": [],
      "category": "clean"
    },
    {
      "id": "go-clean",
      "language": "go",
      "path": "go/clean.go",
      "code": "package main\nfunc add(a, b int) int { return a + b }\n",
      "expected": [],
      "category": "clean"
    }
  ]
}
