        "unsafe-dynamic-code-evaluation"
      ],
      "category": "security"
    },
    {
      "id": "ruby-eval",
      "language": "ruby",
      "path": "ruby/eval.rb",
      "code": "require 'openssl'\ndef run\n  OpenSSL::SSL::VERIFY_NONE\n  verify_mode = OpenSSL::SSL::VERIFY_NONE\nend\n",
      "expected": [
        "tls-certificate-validation-disabled"
      ],
      "category": "security"
    },
    {
      "id": "cs-exec",
      "language": "csharp",
